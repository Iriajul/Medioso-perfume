# Local (non-Docker) development. Copy to .env — it is gitignored.
# Docker/remote environments use deployment/environments/.env.<env>.backend instead.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty to use SQLite, or point at the compose Postgres:
DATABASE_URL=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
