# Copy to .env.production.backend (gitignored) and fill in real values.
DJANGO_SETTINGS_MODULE=core.settings.prod
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=api.bpmstudio.pt,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://admin.bpmstudio.pt
CSRF_TRUSTED_ORIGINS=https://admin.bpmstudio.pt,https://api.bpmstudio.pt

# local compose overrides these with its own postgres/redis containers
DATABASE_URL=postgres://madperfume:madperfume@localhost:5432/madperfume
REDIS_URL=

# S3 media (staging/production) — leave empty to use local filesystem
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Bootstrap superuser (idempotent, created on container start)
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
