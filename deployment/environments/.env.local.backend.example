# Copy to .env.local.backend (gitignored) and fill in real values.
DJANGO_SETTINGS_MODULE=core.settings.dev
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# local compose overrides these with its own postgres/redis containers
DATABASE_URL=postgres://madperfume:madperfume@localhost:5432/madperfume
REDIS_URL=

# S3 media (staging/production) — leave empty to use local filesystem
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Bootstrap superuser (idempotent, created on container start)
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
ADMIN_URL=http://localhost:3000
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=
